{
  "name": "resume_tal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "yarn tokens && next dev",
    "build": "yarn tokens && next build",
    "start": "next start",
    "tokens": "tsx src/shared/tokensTheme/tokens.config.ts",
    "lint": "eslint",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:fix": "lint-staged",
    "lint:all": "eslint --fix \"**/*.{ts,tsx,js,mjs}\" --ignore-pattern node_modules --ignore-pattern .next --ignore-pattern generated",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix"
    ],
    "*.css": [
      "stylelint --fix"
    ]
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "next": "^16.4.3",
    "next-intl": "^4.14.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "reset-css": "^5.0.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "style-dictionary": "^5.7.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.2",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "yarn@1.22.22"
}
